# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado no git. Só `run.py` carrega o .env (python-dotenv);
# `python script.py` não o lê — exporte as variáveis no shell antes (ver DEVELOPMENT.md).
# Em produção (Render) os valores vivem no painel do serviço, um a um (envVars `sync: false` do
# render.yaml). NUNCA copie este arquivo inteiro para o painel: foi assim que PORTAL_URL=localhost
# entrou em produção e todo link de e-mail saiu morto (hotfix 269b).

# ── Ambiente ────────────────────────────────────────────────────────────────
# "development" (padrão) ou "production"
FLASK_ENV=development

# Desliga TODAS as threads de fundo (auto-import de talentos, sync da agenda, backup, limpezas).
# Obrigatório em qualquer script ou preview apontado para o manto_local, e em comando de
# manutenção no Shell/SSH do Render. Em desenvolvimento o FLASK_ENV já segura a maioria; em
# produção, não.
# MANTO_SEM_THREADS=1

# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# ── Banco de dados ──────────────────────────────────────────────────────────
# Desenvolvimento e verificação: a cópia local da produção (manto_local). O valor fica em
# .local-db-url (gitignored) e os scripts exportam DATABASE_URL a partir dele. Sem DATABASE_URL o
# app cai em SQLite — serve só para o app subir, nunca para verificar nada.
# Produção: o Render injeta automaticamente (fromDatabase do manto-postgres no render.yaml).
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/manto_local

# ── Email — Gmail Workspace via App Password ────────────────────────────────
# Com o banco em localhost o envio é SUPRIMIDO (config._suppress_mail); MAIL_ALLOW_LOCAL_SEND=true
# libera de propósito, MAIL_SUPPRESS_SEND=true cala em qualquer ambiente.
MAIL_USERNAME=joao@mantoproducoes.com.br
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_SENDER_NAME=Sistema Manto

# ── Endereços públicos ──────────────────────────────────────────────────────
# **NÃO defina em produção.** Vazio = o endereço real (`PORTAL_BASE_URL` / `PLATFORM_BASE_URL` em
# app/config.py), que é o que o artista e a cliente recebem por e-mail. Um endereço local aqui é
# IGNORADO por qualquer processo que envie e-mail de verdade (269b/269c) — só vale no ambiente
# local, para testar o fluxo contra si mesmo.
# PORTAL_URL=http://localhost:5000
# PUBLIC_BASE_URL=http://localhost:5000

# Cookie de sessão: NÃO defina. Cookie host-only basta; trocar o domínio é mudança de duas partes
# (SESSION_COOKIE_DOMAIN + SESSION_COOKIE_DOMINIOS_OBSOLETOS — feature 295).
# SESSION_COOKIE_DOMAIN=

# Só produção: origens permitidas para CORS, separadas por vírgula (render.yaml). Vazio = desligado.
# CORS_ALLOWED_ORIGINS=https://app.mantoproducoes.com.br

# ── Google OAuth (Google Calendar) ─────────────────────────────────────────
# A rota do callback é /google/callback (app/calendar/routes.py). Registre a URI no Google Cloud
# Console → APIs & Serviços → Credenciais → OAuth 2.0 Client ID.
# Desenvolvimento: http://localhost:5000/google/callback
# Produção: <URL pública registrada no Google Cloud Console>/google/callback — o valor vive na
# envVar sync:false do painel do Render; confira no painel antes de confiar nesta linha. NUNCA
# copie o valor local para o painel.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave do Google Maps (Places / Distance Matrix) — nunca vai para o navegador (constituição XII).
GOOGLE_MAPS_API_KEY=

# ── Agentes semanais (features 221 e 256) ───────────────────────────────────
# Token compartilhado com os scripts locais (.audit-agent-token / .marketing-agent-token, ambos
# gitignored). Sem o env, /api/audit-agent/* e /api/marketing-agent/* respondem 404 — interruptor
# geral. Em produção: painel do Render (sync:false) — ausentes desde a migração de 28/08/2026.
# AUDIT_AGENT_TOKEN=
# MARKETING_AGENT_TOKEN=

# ── Backup automático para o Google Drive (feature 264) ────────────────────
# Id de um DRIVE COMPARTILHADO (conta de serviço não tem cota no My Drive). Vazio = desligado.
# BACKUP_DRIVE_FOLDER_ID=

# ── Integrações de planilha (aposentadas) ──────────────────────────────────
# Ficaram vazias de propósito na migração para o Render; o código ainda as lê.
# TALENTS_SPREADSHEET_ID=
# TALENTS_SHEET_NAME=Respostas
# FIGURINO_DRIVE_FOLDER_ID=
# GOOGLE_SHEETS_CREDENTIALS=

# ── Uploads ─────────────────────────────────────────────────────────────────
# Em produção os arquivos ficam no DISCO PERSISTENTE do Render (10 GB montados em
# /opt/render/project/src/instance: uploads/, nfc_media/, virtual_videos/, .secret_key) — ver
# render.yaml. NÃO existe S3/R2 em produção: USE_S3 é false em todos os ambientes hoje e o
# render.yaml não declara nenhuma variável S3_*. As variáveis abaixo ficam para um dia em que o
# storage saia do disco.
USE_S3=false
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_PUBLIC_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
